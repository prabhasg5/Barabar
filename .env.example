# Copy to .env and fill in. .env is gitignored and must never be committed.
# R3 runs from the committed cache under eval/llm_cache/, so neither key is
# needed to reproduce the numbers -- only to regenerate the cache.

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
